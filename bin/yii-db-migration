#!/usr/bin/env php
<?php

declare(strict_types=1);

use Psr\Container\ContainerInterface;
use Symfony\Component\Console\Application;
use Yiisoft\Db\Connection\ConnectionInterface;
use Yiisoft\Db\Migration\Command\CommandFactory;
use Yiisoft\Db\Migration\DatabaseSet;
use Yiisoft\Db\Migration\DatabaseSetRegistry;
use Yiisoft\Db\Migration\Informer\ConsoleMigrationInformer;
use Yiisoft\Injector\Injector;

$rootPath = dirname(__DIR__, 4);

/** @psalm-suppress UnresolvableInclude, MissingFile */
require $_composer_autoload_path ?? $rootPath . '/vendor/autoload.php';

$configFile = $rootPath . '/yii-db-migration.php';

if (!file_exists($configFile)) {
    fwrite(
        STDERR,
        'Configuration file "' . $configFile . '" not found.' . PHP_EOL
        . 'Copy "' . __DIR__ . '/yii-db-migration.php" to the root folder of your project and configure it:' . PHP_EOL
        . 'cp "' . __DIR__ . '/yii-db-migration.php" "' . $configFile . '"' . PHP_EOL,
    );
    exit(1);
}

/**
 * @psalm-suppress MissingFile
 * @psalm-var array{
 *     container?: ContainerInterface|null,
 *     db?: ConnectionInterface|null,
 *     databases?: array<string, DatabaseSet>,
 *     useTablePrefix?: bool,
 *     historyTable?: string,
 *     migrationNameLimit?: int|null,
 *     maxSqlOutputLength?: int|null,
 *     newMigrationNamespace?: string,
 *     newMigrationPath?: string,
 *     sourceNamespaces?: list<string>,
 *     sourcePaths?: list<string>,
 * } $params
 */
$params = require $configFile;

$sets = $params['databases'] ?? [];
$legacyOptions = [
    'db', 'newMigrationNamespace', 'newMigrationPath', 'sourceNamespaces', 'sourcePaths',
    'historyTable', 'migrationNameLimit', 'useTablePrefix', 'maxSqlOutputLength',
];
if (isset($sets['default'])) {
    foreach ($legacyOptions as $option) {
        if (array_key_exists($option, $params)) {
            throw new LogicException('Configure default migrations either in databases["default"] or with top-level options, not both. Conflicting option: ' . $option . '.');
        }
    }
} else {
    $sets['default'] = new DatabaseSet(
        $params['db'] ?? throw new LogicException('DB connection is not configured.'),
        newMigrationNamespace: $params['newMigrationNamespace'] ?? '',
        newMigrationPath: $params['newMigrationPath'] ?? '',
        sourceNamespaces: $params['sourceNamespaces'] ?? [],
        sourcePaths: $params['sourcePaths'] ?? [],
        historyTable: $params['historyTable'] ?? '{{%migration}}',
        migrationNameLimit: array_key_exists('migrationNameLimit', $params) ? $params['migrationNameLimit'] : 180,
        useTablePrefix: $params['useTablePrefix'] ?? true,
        maxSqlOutputLength: $params['maxSqlOutputLength'] ?? null,
    );
}

$databases = new DatabaseSetRegistry(
    new Injector($params['container'] ?? null),
    new ConsoleMigrationInformer(),
    $sets,
);
$factory = new CommandFactory($databases);
$application = new Application('Yii Database Migration Tool', '1.0.0');
$commands = [];
foreach (['create', 'down', 'history', 'new', 'redo', 'up'] as $name) {
    $commands[] = $factory->create($name);
}
$application->addCommands($commands);
$application->run();
